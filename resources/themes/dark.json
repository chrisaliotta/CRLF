{
  "name": "Dark",
  "editor": {
    "background": "#1e1e1e",
    "foreground": "#d4d4d4",
    "currentLine": "#2a2a2e",
    "selection": "#264f78",
    "gutterBackground": "#1e1e1e",
    "gutterForeground": "#6e7681",
    "codeBlockBackground": "#2b2b2f",
    "diagnosticError": "#f14c4c",
    "diagnosticWarning": "#dcdcaa"
  },
  "tokens": {
    "text": { "color": "#d4d4d4" },
    "keyword": { "color": "#569cd6", "bold": true },
    "type": { "color": "#4ec9b0" },
    "string": { "color": "#ce9178" },
    "number": { "color": "#b5cea8" },
    "comment": { "color": "#6a9955", "italic": true },
    "preprocessor": { "color": "#c586c0" },
    "function": { "color": "#dcdcaa" },
    "operator": { "color": "#d4d4d4" }
  },
  "terminal": {
    "black": "#000000",
    "red": "#f14c4c",
    "green": "#6a9955",
    "yellow": "#dcdcaa",
    "blue": "#569cd6",
    "magenta": "#c586c0",
    "cyan": "#4ec9b0",
    "white": "#d4d4d4",
    "brightBlack": "#808080",
    "brightRed": "#f44747",
    "brightGreen": "#b5cea8",
    "brightYellow": "#d7ba7d",
    "brightBlue": "#9cdcfe",
    "brightMagenta": "#d670d6",
    "brightCyan": "#29b8db",
    "brightWhite": "#ffffff"
  }
}

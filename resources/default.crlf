{
  "commands": [],
  "syntax": {
    "enabled": true,
    "command": {
      "wsl": "bash \"${programDir}/scripts/syntax.sh\" \"${file}\""
    }
  },
  "autocomplete": {
    "enabled": true,
    "command": {
      "wsl": "bash \"${programDir}/scripts/autocomplete.sh\""
    }
  },
  "agents": [
    {
      "name": "Claude",
      "command": {
        "windows": "python \"${programDir}/scripts/agent/crlf_agent.py\" --provider anthropic --model claude-sonnet-4-5 --api-key-file \"${appDir}/keys/anthropic\" --rules .crlf/rules --rules \"${appDir}/rules\"",
        "wsl": "python3 \"${programDir}/scripts/agent/crlf_agent.py\" --provider anthropic --model claude-sonnet-4-5 --api-key-file \"${appDir}/keys/anthropic\" --rules .crlf/rules --rules \"${appDir}/rules\""
      }
    },
    {
      "name": "GPT",
      "command": {
        "windows": "python \"${programDir}/scripts/agent/crlf_agent.py\" --provider openai --model gpt-5 --reasoning-effort low --api-key-file \"${appDir}/keys/openai\" --rules .crlf/rules --rules \"${appDir}/rules\"",
        "wsl": "python3 \"${programDir}/scripts/agent/crlf_agent.py\" --provider openai --model gpt-5 --reasoning-effort low --api-key-file \"${appDir}/keys/openai\" --rules .crlf/rules --rules \"${appDir}/rules\""
      }
    },
    {
      "name": "Grok",
      "command": {
        "windows": "python \"${programDir}/scripts/agent/crlf_agent.py\" --provider xai --model grok-4 --api-key-file \"${appDir}/keys/xai\" --rules .crlf/rules --rules \"${appDir}/rules\"",
        "wsl": "python3 \"${programDir}/scripts/agent/crlf_agent.py\" --provider xai --model grok-4 --api-key-file \"${appDir}/keys/xai\" --rules .crlf/rules --rules \"${appDir}/rules\""
      }
    },
    {
      "name": "Local",
      "command": {
        "windows": "python \"${programDir}/scripts/agent/crlf_agent.py\" --provider ollama --model qwen3-coder --rules .crlf/rules --rules \"${appDir}/rules\"",
        "wsl": "python3 \"${programDir}/scripts/agent/crlf_agent.py\" --provider ollama --model qwen3-coder --rules .crlf/rules --rules \"${appDir}/rules\""
      }
    }
  ]
}

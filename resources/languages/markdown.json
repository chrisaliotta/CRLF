{
  "name": "Markdown",
  "extensions": ["md", "markdown"],
  "embedded": [
    { "start": "^\\s*```\\s*([\\w+#.-]*)", "end": "^\\s*```\\s*$", "languageCapture": 1 },
    { "start": "^\\s*~~~\\s*([\\w+#.-]*)", "end": "^\\s*~~~\\s*$", "languageCapture": 1 }
  ],
  "patterns": [
    { "role": "keyword", "regex": "^#{1,6}\\s.*$" },
    { "role": "type", "regex": "\\*\\*[^*]+\\*\\*|__[^_]+__" },
    { "role": "string", "regex": "`[^`]+`" },
    { "role": "function", "regex": "\\[[^\\]]*\\]\\([^)]*\\)" },
    { "role": "operator", "regex": "^\\s*([-*+]|\\d+\\.)\\s" },
    { "role": "comment", "regex": "^>.*$" }
  ],
  "folding": { "mode": "heading" }
}

{
  "name": "C++",
  "extensions": ["cpp", "cxx", "cc", "c", "hpp", "hxx", "hh", "h", "inl"],
  "lineComment": "//",
  "blockComment": { "start": "/*", "end": "*/" },
  "strings": [
    { "start": "\"", "end": "\"", "escape": "\\" },
    { "start": "'", "end": "'", "escape": "\\" }
  ],
  "keywords": [
    "alignas", "alignof", "asm", "break", "case", "catch", "class", "concept",
    "const", "consteval", "constexpr", "constinit", "const_cast", "continue",
    "co_await", "co_return", "co_yield", "decltype", "default", "delete", "do",
    "dynamic_cast", "else", "enum", "explicit", "export", "extern", "false",
    "final", "for", "friend", "goto", "if", "inline", "mutable", "namespace",
    "new", "noexcept", "nullptr", "operator", "override", "private",
    "protected", "public", "reinterpret_cast", "requires", "return", "sizeof",
    "static", "static_assert", "static_cast", "struct", "switch", "template",
    "this", "thread_local", "throw", "true", "try", "typedef", "typeid",
    "typename", "union", "using", "virtual", "volatile", "while"
  ],
  "types": [
    "auto", "bool", "char", "char8_t", "char16_t", "char32_t", "double",
    "float", "int", "long", "short", "signed", "unsigned", "void", "wchar_t",
    "size_t", "ptrdiff_t", "int8_t", "int16_t", "int32_t", "int64_t",
    "uint8_t", "uint16_t", "uint32_t", "uint64_t", "qreal", "qsizetype"
  ],
  "patterns": [
    { "role": "number", "regex": "\\b(0[xXbB][0-9a-fA-F']+|\\d[\\d']*(\\.\\d+)?([eE][+-]?\\d+)?)[fFuUlLzZ]*\\b" },
    { "role": "preprocessor", "regex": "^\\s*#\\s*\\w+" },
    { "role": "function", "regex": "\\b[A-Za-z_]\\w*(?=\\s*\\()" }
  ],
  "symbols": [
    { "regex": "(?<![<,]\\s{0,40})\\b(?:class|struct|union|enum(?:\\s+class)?)\\s+([A-Za-z_]\\w*)" },
    { "regex": "\\busing\\s+([A-Za-z_]\\w*)\\s*=" },
    { "regex": "\\btypedef\\s+(?:(?:struct|class|enum|union)\\s+)?(?:[A-Za-z_][\\w:<>]*\\s+)+([A-Za-z_]\\w*)\\s*;" },
    { "regex": "(?m)^[ \\t]*(?!(?:return|if|for|while|switch|else|case|goto|delete|throw|try|catch|do|new)\\b)(?:(?:static|const|constexpr|volatile|mutable|extern|unsigned|signed|long|short)\\s+)*(?:[A-Za-z_][\\w:<>,\\*&]*\\s+)+([A-Za-z_]\\w*)\\s*(?:=|;)", "local": true },
    { "regex": "(?:[(,]\\s*(?:const\\s+)?)(?:[A-Za-z_][\\w:<>,\\*&]*\\s+)+([A-Za-z_]\\w*)\\s*(?:,|\\)|=)", "local": true },
    { "regex": "\\bfor\\s*\\(\\s*(?:const\\s+)?(?:auto|[A-Za-z_][\\w:<>,\\*&]*)\\s*&{0,2}\\s*([A-Za-z_]\\w*)\\s*:", "local": true },
    { "regex": "(?m)^[ \\t]*(?:(?:virtual|static|inline|explicit|constexpr|friend|unsigned|const)\\s+)*(?:[A-Za-z_][\\w:<>,\\*&]*\\s+)*([A-Za-z_]\\w*)\\s*\\([^;]*\\)\\s*(?:const\\s*)?(?:override\\s*)?(?:noexcept(?:\\([^)]*\\))?\\s*)?(?:final\\s*)?(?::[^{]+)?\\{", "local": true }
  ],
  "folding": {
    "mode": "delimiter",
    "pairs": [{ "open": "{", "close": "}" }]
  }
}

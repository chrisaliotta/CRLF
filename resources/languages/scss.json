{
  "name": "SCSS",
  "extensions": ["scss"],
  "lineComment": "//",
  "blockComment": { "start": "/*", "end": "*/" },
  "strings": [
    { "start": "\"", "end": "\"", "escape": "\\" },
    { "start": "'", "end": "'", "escape": "\\" }
  ],
  "keywords": [
    "and", "content", "each", "else", "error", "extend", "for", "forward",
    "from", "function", "if", "important", "include", "mixin", "not", "of",
    "only", "or", "return", "through", "to", "use", "warn", "while", "with"
  ],
  "patterns": [
    { "role": "number", "regex": "#[0-9a-fA-F]{3,8}\\b|\\b\\d+(\\.\\d+)?(%|px|em|rem|vh|vw|vmin|vmax|ch|ex|pt|pc|in|cm|mm|deg|rad|turn|s|ms|fr)?\\b" },
    { "role": "preprocessor", "regex": "@[\\w-]+|\\$[\\w-]+|#\\{[^}]*\\}" },
    { "role": "keyword", "regex": "&" },
    { "role": "type", "regex": "(?<=[{};]\\s{0,40}|^\\s{0,40})-?[-A-Za-z]+(?=\\s*:)" },
    { "role": "function", "regex": "\\b[A-Za-z_][\\w-]*(?=\\()" }
  ],
  "folding": {
    "mode": "delimiter",
    "pairs": [{ "open": "{", "close": "}" }]
  }
}

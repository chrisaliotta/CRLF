{
  "name": "CSS",
  "extensions": ["css"],
  "blockComment": { "start": "/*", "end": "*/" },
  "strings": [
    { "start": "\"", "end": "\"", "escape": "\\" },
    { "start": "'", "end": "'", "escape": "\\" }
  ],
  "keywords": ["and", "from", "important", "not", "only", "or", "to"],
  "patterns": [
    { "role": "number", "regex": "#[0-9a-fA-F]{3,8}\\b|\\b\\d+(\\.\\d+)?(%|px|em|rem|vh|vw|vmin|vmax|ch|ex|pt|pc|in|cm|mm|deg|rad|turn|s|ms|fr|dpi|dppx|dvh|dvw|svh|svw|lvh|lvw)?\\b" },
    { "role": "preprocessor", "regex": "@[\\w-]+" },
    { "role": "type", "regex": "(?<=[{};]\\s{0,40}|^\\s{0,40})-?[-A-Za-z]+(?=\\s*:)" },
    { "role": "function", "regex": "\\b[A-Za-z_][\\w-]*(?=\\()" }
  ],
  "folding": {
    "mode": "delimiter",
    "pairs": [{ "open": "{", "close": "}" }]
  }
}
